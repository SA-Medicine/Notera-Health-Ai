# ── Notera-Health-Ai — environment (copy to .env; never commit real secrets) ──

# ── Generation (Gemini) — doc 06 ─────────────────────────────────────────────
# ai_studio = Google AI Studio API (de-identified input only, NOT BAA-covered)
# vertex    = Vertex AI (HIPAA-eligible under a BAA; PHI allowed)
LLM_BACKEND=ai_studio
GEMINI_API_KEY=your_ai_studio_key_here
# GEMINI_MODEL overrides both tiers at once (used by every agent).
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-flash
GEMINI_MODEL_FLASH=gemini-2.5-flash
# Run the model to its full output ceiling on every call (no artificial cap).
GEMINI_MAX_OUTPUT_TOKENS=65536
# Reasoning depth for gemini-3.x: high | low | off. (off = fastest; recommended here)
GEMINI_THINKING_LEVEL=off

# LLM gold-style tightener (recovers dropped plan facts, trims filler, grounded). 1=on.
NOTE_TIGHTENER=1

# ── No-duplicates pass (final stage before the note is rendered) ──────────────
# Deterministic de-duplication always runs. SEMANTIC_DEDUPE adds an LLM pass that
# finds PARAPHRASED repeats (the same clinical point in different words) which word
# overlap cannot see; it only selects lines to delete, never rewrites them, and every
# proposed merge is vetted against conflicting numbers / drugs / meaning. Set to 0 to
# disable. Fails open on any error or timeout.
SEMANTIC_DEDUPE=1
SEMANTIC_DEDUPE_TIMEOUT_MS=25000

# ── Large-scan tuning (150+ patient runs) ────────────────────────────────────
# Parallel patients per scan. 1 = sequential (clean per-agent logs). Raise to 3–4 to make
# big scans ~3–4× faster (logs interleave). Each patient makes ~8 LLM calls + RxNorm.
RUN_CONCURRENCY=1
# Hard timeout per patient so one stuck record can't freeze the scan.
RUN_FIXTURE_TIMEOUT_MS=300000
# A "running" scan whose progress hasn't advanced in this long is treated as interrupted
# (so the UI stops spinning forever and you can Resume/Retry).
RUN_STALE_MS=900000

# ── DeepSeek "Second Opinion" reviewer (independent note critique) ────────────
# Independent, brutally-honest expert review of a generated note (no gold reference).
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_MODEL=deepseek-v4-flash          # latest flash; also deepseek-v4-pro / deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Thinking mode is ON by default at DeepSeek and is slow (dev proxy times out). Keep it
# 'disabled' for the fast structured critique; set 'enabled' only if you want deep reasoning.
DEEPSEEK_THINKING=disabled

# ── RxNorm medication verification (upgrade D-Tier2) ─────────────────────────
# 1 = flag medications that don't resolve to a real RxNorm concept (higher note quality).
RXNORM_VERIFY=1
# Default public NLM RxNav API; for PHI-safe/offline use RxNav-in-a-Box: http://localhost:4000/REST
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
# For Vertex:
GCP_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1

# ── NER sidecar (doc 07 §4) ──────────────────────────────────────────────────
NER_URL=http://localhost:8000
NER_USE_IAM=false            # true in prod (Cloud Run → Cloud Run ID token)

# ── Data layer (doc 09) ──────────────────────────────────────────────────────
FIRESTORE_DRIVER=memory      # memory (dev) | firestore (prod)

# ── Medical ASR (doc 08) ─────────────────────────────────────────────────────
# Google Speech-to-Text. Recordings of ANY length work: audio is decoded to 16 kHz mono
# PCM and, past the API's ~60s synchronous limit, split into windows and stitched back
# together (the splits land on quiet stretches and never overlap, so no phrase is lost
# or transcribed twice).
#
# Cost guard: any 'medical*' or 'chirp*' value is forced down to the standard-priced
# 'latest_long' ($0.016/min) so the premium 'medical_conversation' (~5x) is never billed.
# GCP credentials for Speech-to-Text (and Vertex, when LLM_BACKEND=vertex). Without
# these every ASR request fails at the call. In the container this is the mounted key;
# locally point it at the service-account JSON in ./secrets.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/sa-key.json
GOOGLE_CLOUD_PROJECT=your-gcp-project
ASR_MODEL=medical_conversation
ASR_LANGUAGE=en-US
ASR_SAMPLE_RATE=16000
# Window length for long audio (hard-capped at 55s, under the 60s API limit), how far
# either side of a boundary to hunt for a quiet split point, and how many windows to
# recognise at once.
ASR_WINDOW_SECONDS=50
ASR_SPLIT_SEARCH_SECONDS=2
ASR_WINDOW_CONCURRENCY=3
# Retries for a transient upstream failure (UNAVAILABLE / quota / deadline) on each window.
ASR_RETRIES=2
# Upload ceiling - must fit a whole consult, since the client re-sends the full recording
# to recover any segment that failed mid-session. WebM/Opus is ~0.5 MB/minute.
ASR_MAX_UPLOAD=120mb
# ffmpeg decode budget: base + per-MB, capped. A 20s chunk decodes instantly; a full
# consult needs proportionally longer, and a flat ceiling used to kill the long case.
ASR_FFMPEG_TIMEOUT_MS=45000
ASR_FFMPEG_PER_MB_MS=4000
ASR_FFMPEG_MAX_TIMEOUT_MS=600000

# ── Backend service ──────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
REQUIRE_AUTH=false
SERVICE_TOKENS=dev-token     # comma-separated bearer tokens the web app presents (dev)
PIPELINE_VERSION=notera-pipeline-v31

# ── Frontend (web/) ──────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8080
BACKEND_SERVICE_TOKEN=dev-token

# ── PostgreSQL (data store) ───────────────────────────────────────────────────
STORE_BACKEND=postgres                                   # postgres | firestore | memory
DATABASE_URL=postgres://notera_admin:CHANGE_ME@localhost:5432/notera
PG_POOL_MAX=10
PGSSL=                                                    # 'require' to force TLS
DEID_ENC_KEY=CHANGE_ME_ENCRYPTION_KEY                     # pgcrypto key for the de-id map (keep in a KMS in prod)
