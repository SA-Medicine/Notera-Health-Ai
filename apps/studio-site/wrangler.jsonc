{
  // Notera Studio site — its own Worker, same Cloudflare account as the admin site.
  // Deploy:  CLOUDFLARE_ACCOUNT_ID=<id> CLOUDFLARE_API_TOKEN=<scoped token> npx wrangler deploy   (run from this folder)
  // Secret:  the shared key is set once with `wrangler secret put STUDIO_KEY` (value in secrets/studio-key.txt, never in git).
  "name": "notera-studio",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "API_ORIGIN": "https://api.aitoolsfordoctor.com" },
  "routes": [{ "pattern": "studio.aitoolsfordoctor.com", "custom_domain": true }]
}
