{
  // Notera admin site — its OWN Worker, deployed to a Cloudflare account separate from the main website.
  // Deploy:  CLOUDFLARE_ACCOUNT_ID=<id> CLOUDFLARE_API_TOKEN=<scoped token> npx wrangler deploy   (run from this folder)
  "name": "notera-admin",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "API_ORIGIN": "https://api.aitoolsfordoctor.com" },
  "routes": [{ "pattern": "admin.aitoolsfordoctor.com", "custom_domain": true }]
}
