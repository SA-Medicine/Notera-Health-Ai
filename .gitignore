# Dependencies
node_modules/
**/node_modules/
.venv/
__pycache__/
*.pyc

# Env / secrets
.env
.env.local
.env.*.local
*-key.json
service-account*.json

# Build output
.next/
dist/
build/
.turbo/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Data (PHI must never be committed)
data/raw/
data/deidentified/
data/out/
eval/results/
*.wav
*.mp3
audio_data/
# Database backups (may contain PHI)
db/backups/
*.dump

# Admin runtime state — regenerated at runtime, not source. The tester writes per-run
# stdout logs here plus a run-history index; these should never be committed.
admin/data/logs/
admin/data/runs.json
admin/data/.session_secret

# Prompt exports (the "Export all" zip downloads locally) and misc temp/editor files
notera-prompts-*.zip
*.tmp
*~

# RxNorm on-disk lookup cache (regenerated from the RxNav API)
**/.cache/
rxnorm.json

# NOTE: data/gold/*.txt is the versioned (transcript → gold note) dataset and is
# intentionally committed (see data/README.md). If you'd rather NOT track the bulk
# imported clinical fixtures, untrack them with:
#   git rm -r --cached data/gold && git commit -m "stop tracking run fixtures"
# then add:  data/gold/
.env.production
db/secrets/
secrets/
*sa-key.json
.data/
medproject-*.json
