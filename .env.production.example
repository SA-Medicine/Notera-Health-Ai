# ─────────────────────────────────────────────────────────────────────────────
# Notera backend — PRODUCTION env template.
#   Copy to .env.production on the VM and fill in. NEVER commit the real file.
#   chmod 600 .env.production   (owner-read only)
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8080
REQUIRE_AUTH=true                 # enforce login on every clinician route
ENABLE_ADMIN=0                    # admin/testing-lab stays OUT of production
NER_DISABLED=1                    # no NER sidecar

# ── Auth / session ──
# 32+ random bytes. Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=REPLACE_WITH_openssl_rand_hex_32
ADMIN_SESSION_TTL_DAYS=7
APP_URL=https://app.notera.health         # used in password-reset links
CORS_ORIGIN=https://app.notera.health     # ONLY the Vercel frontend may call the API

# ── Database (co-located Postgres on this VM) ──
DATABASE_URL=postgres://notera_admin:PASTE_PG_PASSWORD_HERE@postgres:5432/notera
# PGSSL=require                           # set if you enable Postgres TLS
STORE_BACKEND=postgres                    # persist consults/transcripts/notes (not in-memory)
DEID_ENC_KEY=REPLACE_WITH_openssl_rand_hex_32   # encrypts the de-id map in Postgres

# ── Audio storage (voice recordings) ──
GCS_AUDIO_BUCKET=medproject-506019-notera-audio  # create this bucket; download via signed URLs

# ── LLM: Vertex AI (HIPAA-covered under your BAA) ──
LLM_BACKEND=vertex
GCP_PROJECT=notera-prod
# 'global' = Vertex's dynamic worldwide fleet → CHEAPEST (no regional premium). Recommended
# unless you have a hard data-residency rule; then pin to 'us-central1' (cheapest US region).
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash             # or gemini-2.5-flash-lite for lower cost
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/sa-key.json
GEMINI_MAX_OUTPUT_TOKENS=65536

# ── Medical ASR: local faster-whisper large-v3-turbo ──
# Runtime transcription stays inside the backend container/VM. Google Speech remains
# available only as rollback by changing ASR_PROVIDER=google and redeploying.
ASR_PROVIDER=whisper_local
ASR_WHISPER_MODEL=large-v3-turbo
ASR_WHISPER_DEVICE=auto                 # auto -> cuda/float16 when usable, else cpu/int8
ASR_WHISPER_COMPUTE_TYPE=
ASR_WHISPER_LANGUAGE=en
ASR_WHISPER_BEAM_SIZE=5
ASR_WHISPER_VAD_FILTER=true
ASR_WHISPER_CONDITION_ON_PREVIOUS_TEXT=true
ASR_TIMEOUT_MS=180000
# Google rollback settings:
ASR_MODEL=medical_conversation
ASR_LANGUAGE=en-US
ASR_SAMPLE_RATE=16000

# ── Second Opinion (DeepSeek) — DISABLED for real PHI (no BAA). Leave unset. ──
# DEEPSEEK_API_KEY=

# ── Email (password resets / invites — NON-PHI only) ──
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey_or_username
SMTP_PASS=REPLACE
SMTP_FROM=no-reply@notera.health

# ── Pipeline tuning (safe defaults) ──
HALLUCINATION_REMOVER=1
NORMALIZE_DEID_DATES=0            # OFF in production (real transcripts have real dates)

# ── Per-agent output-token caps (safety ceilings; LLMService applies by agent name) ──
CLINICAL_STORY_MAX_OUTPUT_TOKENS=20000
EXTRACTOR_MAX_OUTPUT_TOKENS=15000
QA_MAX_OUTPUT_TOKENS=6000
FACT_RECOVERY_MAX_OUTPUT_TOKENS=8000
STORY_COMPOSER_MAX_OUTPUT_TOKENS=8000
TIGHTENER_MAX_OUTPUT_TOKENS=6000
HALLUCINATION_REMOVER_MAX_OUTPUT_TOKENS=4000
