# ─────────────────────────────────────────────────────────────────────────────
# Notera backend — PRODUCTION env template.
#   Copy to .env.production on the VM and fill in. NEVER commit the real file.
#   chmod 600 .env.production   (owner-read only)
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8080
REQUIRE_AUTH=true                 # enforce login on every clinician route
ENABLE_ADMIN=0                    # admin/testing-lab stays OUT of production
NER_DISABLED=1                    # no NER sidecar

# ── Auth / session ──
# 32+ random bytes. Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=REPLACE_WITH_openssl_rand_hex_32
ADMIN_SESSION_TTL_DAYS=7
APP_URL=https://app.notera.health         # used in password-reset links
CORS_ORIGIN=https://app.notera.health     # ONLY the Vercel frontend may call the API

# ── Database (co-located Postgres on this VM) ──
DATABASE_URL=postgres://notera_admin@postgres:5432/notera
# PGSSL=require                           # set if you enable Postgres TLS

# ── LLM: Vertex AI (HIPAA-covered under your BAA) ──
LLM_BACKEND=vertex
GCP_PROJECT=notera-prod
# 'global' = Vertex's dynamic worldwide fleet → CHEAPEST (no regional premium). Recommended
# unless you have a hard data-residency rule; then pin to 'us-central1' (cheapest US region).
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash             # or gemini-2.5-flash-lite for lower cost
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/sa-key.json
GEMINI_MAX_OUTPUT_TOKENS=65536

# ── Speech-to-Text (only if you accept audio; else ignore) ──
# GCS_AUDIO_BUCKET=notera-prod-audio
# SPEECH_LANGUAGE=en-US

# ── Second Opinion (DeepSeek) — DISABLED for real PHI (no BAA). Leave unset. ──
# DEEPSEEK_API_KEY=

# ── Email (password resets / invites — NON-PHI only) ──
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey_or_username
SMTP_PASS=REPLACE
SMTP_FROM=no-reply@notera.health

# ── Pipeline tuning (safe defaults) ──
HALLUCINATION_REMOVER=1
NORMALIZE_DEID_DATES=0            # OFF in production (real transcripts have real dates)
